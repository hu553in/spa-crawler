# syntax=docker/dockerfile:1

FROM caddy:2.11.4-alpine AS caddy-runtime

FROM caddy:2.11.4-builder-alpine AS caddy-builder

# Rebuild stock Caddy with current Go to avoid vulnerabilities in the upstream binary.
FROM golang:1.26.5-alpine3.23 AS builder

COPY --from=caddy-builder /usr/bin/xcaddy /usr/local/bin/xcaddy
COPY --from=caddy-runtime /usr/bin/caddy /tmp/caddy

RUN --mount=type=cache,target=/go/pkg/mod \
  --mount=type=cache,target=/root/.cache/go-build \
  CADDY_VERSION=$(/tmp/caddy version) \
  && CADDY_VERSION=${CADDY_VERSION%% *} \
  && CGO_ENABLED=0 xcaddy build "${CADDY_VERSION}" \
  --replace golang.org/x/text=golang.org/x/text@v0.39.0 \
  --replace google.golang.org/grpc=google.golang.org/grpc@v1.82.1 \
  --output /out/caddy

FROM caddy-runtime

RUN apk upgrade --no-cache \
  && addgroup --system --gid 1000 caddy \
  && adduser --system --disabled-password --no-create-home --uid 1000 --ingroup caddy caddy

COPY --from=builder /out/caddy /usr/bin/caddy

COPY --chown=caddy:caddy out /srv

RUN set -eu; \
  if [ ! -f /srv/redirects.caddy ]; then \
    printf '%s\n' '# Auto-generated by spa-crawler from observed redirects.' '# Include this file from your Caddy config.' '# rules_written: 0' '# skipped_query_sources: 0' > /srv/redirects.caddy; \
  fi; \
  chown -R caddy:caddy /config /data /srv

COPY --chown=caddy:caddy Caddyfile /etc/caddy/Caddyfile

RUN ENABLE_BASIC_AUTH=false \
  BASIC_AUTH_USER=check \
  BASIC_AUTH_PASSWORD_HASH='$2a$14$4YbfeJZykhrkPU6.Q7XYE.6tdjDUwMuEBEK8aVM1frvtyQhiA22vG' \
  caddy validate --config /etc/caddy/Caddyfile

USER caddy

EXPOSE 8080
